# Local development only. Production values belong in GitHub Actions secrets.
FKART_LOGIN_ID=your_flipkart_email_or_phone
FKART_PASSWORD=your_flipkart_password_if_requested
FKART_EMAIL=your_gmail_address_for_authorized_otp_retrieval
FKART_APP_PASSWORD=your_gmail_imap_app_password

# OTP: ADB / phone SMS retrieval is no longer used. Set FKART_LOGIN_ID to the Flipkart
# email address so the OTP is read from Gmail (FKART_EMAIL / FKART_APP_PASSWORD),
# or reuse the signed-in Chrome profile on the runner.

SMTP_USER=your_gmail_sender_address
SMTP_APP_PASSWORD=your_gmail_smtp_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
ALERT_TO=administrator@example.com

# Optional local defaults; request dates are passed dynamically for each run.
START_DATE=
END_DATE=
